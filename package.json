{
  "name": "tolou-concrete-engineering-suite",
  "version": "0.9.5",
  "description": "Tolou Concrete Engineering Suite - professional concrete engineering decision platform",
  "main": "electron/main.cjs",
  "author": {
    "name": "Tolou Engineering"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "npm run icon:build && electron-builder --dir",
    "dist:win": "npm run icon:build && electron-builder --win nsis --publish never",
    "icon:build": "node scripts/build-icon.cjs",
    "qa:sample": "node scripts/validate-sample-project.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "svg-to-ico": "^2.0.0"
  },
  "build": {
    "appId": "ir.tolou.concrete.engineering",
    "productName": "Tolou Concrete Engineering Suite",
    "asar": true,
    "files": [
      "electron/**/*",
      "app/**/*",
      "assets/**/*",
      "baseline/Tolou_MASTER_Stage6.5.html",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tolou Concrete Engineering Suite",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Tolou-Concrete-Engineering-Suite-Setup-${version}.${ext}",
      "uninstallDisplayName": "Tolou Concrete Engineering Suite",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "allowElevation": true
    },
    "executableName": "Tolou Concrete Engineering Suite"
  },
  "copyright": "Copyright © 2026 Tolou Engineering"
}
